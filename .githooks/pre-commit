#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

NOTES_FILE="Release Notes.md"

if [[ ! -x vendor/bin/phpstan || ! -x vendor/bin/php-cs-fixer ]]; then
    echo "pre-commit: vendor binaries are missing. Run composer install." >&2
    exit 1
fi

echo "pre-commit: running PHP CS Fixer..."
vendor/bin/php-cs-fixer fix

cs_fixer_changed=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: PHP CS Fixer modified staged file: $file" >&2
        cs_fixer_changed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ "$cs_fixer_changed" -eq 1 ]]; then
    echo "pre-commit: CS Fixer found style issues and updated files. Stage the fixes and commit again." >&2
    exit 1
fi

echo "pre-commit: running PHPStan..."
if ! vendor/bin/phpstan analyse; then
    echo "pre-commit: PHPStan reported errors. Commit blocked." >&2
    exit 1
fi

bash "${ROOT}/.githooks/pre-commit-review"

if [[ "${GIT_PRE_COMMIT_SKIP_RELEASE_NOTES:-}" == "1" ]]; then
    echo "pre-commit: skipping Release Notes update (GIT_PRE_COMMIT_SKIP_RELEASE_NOTES=1)."
    exit 0
fi

staged_files="$(git diff --cached --name-only -- . ":!${NOTES_FILE}" || true)"
if [[ -z "$staged_files" ]]; then
    echo "pre-commit: no staged files besides Release Notes; skipping notes update."
    exit 0
fi

echo "pre-commit: updating ${NOTES_FILE}..."

entry_file="$(mktemp)"
trap 'rm -f "$entry_file"' EXIT

{
    echo "- **$(date +'%Y-%m-%d %H:%M')**"
    git diff --cached --name-status -- . ":!${NOTES_FILE}" | while IFS=$'\t' read -r status first second; do
        [[ -z "${status:-}" ]] && continue
        case "$status" in
            A*) printf '  - added: `%s`\n' "$first" ;;
            M*) printf '  - modified: `%s`\n' "$first" ;;
            D*) printf '  - deleted: `%s`\n' "$first" ;;
            R*) printf '  - renamed: `%s` -> `%s`\n' "$first" "$second" ;;
            *) printf '  - %s: `%s`\n' "$status" "$first" ;;
        esac
    done
    echo
} >"$entry_file"

if [[ ! -f "$NOTES_FILE" ]]; then
    printf '# Release Notes\n\n## Unreleased\n\n' >"$NOTES_FILE"
fi

if ! grep -qx '## Unreleased' "$NOTES_FILE"; then
    tmp_notes="$(mktemp)"
    awk 'NR==1 { print; print ""; print "## Unreleased"; print ""; next } { print }' "$NOTES_FILE" >"$tmp_notes"
    mv "$tmp_notes" "$NOTES_FILE"
fi

tmp_notes="$(mktemp)"
awk -v entry_file="$entry_file" '
    /^## Unreleased$/ {
        print
        print ""
        while ((getline line < entry_file) > 0) {
            print line
        }
        close(entry_file)
        next
    }
    { print }
' "$NOTES_FILE" >"$tmp_notes"
mv "$tmp_notes" "$NOTES_FILE"

git add -- "$NOTES_FILE"

echo "pre-commit: checks passed."
